@model ServiceProvider
<div class="container py-5" style="max-width:700px"><div class="card shadow-sm p-4"><h2>Add Provider</h2><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="ProviderName"></label><input asp-for="ProviderName" class="form-control" /></div>
<div class="mb-3"><label asp-for="Service"></label><input asp-for="Service" class="form-control" /></div>
<div class="mb-3"><label asp-for="Mobile"></label><input asp-for="Mobile" class="form-control" /></div>
<div class="mb-3"><label asp-for="Address"></label><textarea asp-for="Address" class="form-control"></textarea></div>
<div class="mb-3"><label asp-for="Experience"></label><input asp-for="Experience" class="form-control" /></div>
<div class="form-check mb-3"><input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable" class="form-check-label"></label></div>
<button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-secondary">Back</a></form></div></div>
