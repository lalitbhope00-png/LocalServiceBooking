<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Local Service Booking</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background:#f5f7fb; }
        .hero { padding:70px 20px; background:linear-gradient(135deg,#0d6efd,#6f42c1); color:white; border-radius:0 0 30px 30px; }
        .card { border:0; border-radius:18px; }
        footer { margin-top:60px; padding:25px 0; }
    </style>
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white shadow-sm">
<div class="container">
<a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Local Service</a>
<div class="navbar-nav ms-auto">
<a class="nav-link" asp-controller="Customer" asp-action="Bookings">My Bookings</a>
<a class="nav-link" asp-controller="Account" asp-action="Login">Admin</a>
</div>
</div>
</nav>
<main>@RenderBody()</main>
<footer class="text-center text-muted">Local Service Booking & Management System</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
